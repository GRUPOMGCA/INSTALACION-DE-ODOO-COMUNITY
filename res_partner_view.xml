<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- View form of res_partner -->
        <record id="view_res_partner_form_inherit" model="ir.ui.view">
            <field name="name">res_partner_form_inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="arch" type="xml">
                
                <!-- 1. Reemplazo del formato de dirección adaptado a Odoo 17 con street2 invisible -->
                <xpath expr="//div[hasclass('o_address_format')]" position="replace">
                    <div class="o_address_format">
                        <field name="country_id" placeholder="Country" class="o_address_country" options="{'no_open': True, 'no_create': True}" readonly="type == 'contact' and parent_id != False"/>
                        <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_create': True}" readonly="type == 'contact' and parent_id != False" context="{'country_id': country_id, 'zip': zip}"/>
                        <field name="municipality_id" placeholder="Municipio" class="o_address_city" options="{'no_open': True, 'no_create': True}" domain="[('state_id', '=', state_id)]" />
                        <field name="city" placeholder="Ciudad" class="o_address_city" readonly="type == 'contact' and parent_id != False"/>
                        <field name="parish_id" placeholder="Parroquia" options="{'no_open': True, 'no_create': True}" class="o_address_state" domain="[('municipality_id', '=', municipality_id)]" />
                        <field name="zip" placeholder="ZIP" class="o_address_zip" readonly="type == 'contact' and parent_id != False"/>
                        <field name="street" placeholder="Calle..." class="o_address_street"/>
                        <!-- Campo invisible requerido obligatoriamente por el núcleo de Odoo 17 -->
                        <field name="street2" invisible="1"/>
                    </div>
                </xpath>

                <!-- 2. Ajuste del Tipo de Responsabilidad SENIAT sin atributos obsoletos -->
                <xpath expr="//field[@name='vat']" position="after">
                    <field name="l10n_ve_responsibility_type_id" options="{'no_open': True, 'no_create': True}" readonly="parent_id != False"/>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
